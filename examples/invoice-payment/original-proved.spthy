lemma Transfer_Requires_Confirmation:
  all-traces
  "∀ b h s svc amt acc #t.
    (Transfer( b, h, s, svc, amt, acc ) @ #t) ⇒
    (∃ #o #c.
      ((((PaymentOrder( h, b, s, svc, amt, acc ) @ #o) ∧
         (WarningShown( h, b ) @ #c)) ∧
        (Confirmed( h, b, s, svc, amt, acc ) @ #c)) ∧
       (#o < #c)) ∧
      (#c < #t))"
/*
guarded formula characterizing all counter-examples:
"∃ b h s svc amt acc #t.
  (Transfer( b, h, s, svc, amt, acc ) @ #t)
 ∧
  ∀ #o #c.
   (PaymentOrder( h, b, s, svc, amt, acc ) @ #o) ∧
   (WarningShown( h, b ) @ #c) ∧
   (Confirmed( h, b, s, svc, amt, acc ) @ #c)
  ⇒
   ((¬(#o < #c)) ∨ (¬(#c < #t)))"
*/
simplify
solve( State( $B, '2', <$Human, ltkB, pk(x), s, svc, amt, acc> ) ▶₀ #t )
